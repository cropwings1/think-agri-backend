NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
ADMIN_EMAIL=admin@example.com
# Generate with: npm run db:hash-password -- 'your-long-password'
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
COOKIE_NAME=ta_admin_session
COOKIE_SECURE=false
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_EN=farmer_community_invites_en
WHATSAPP_TEMPLATE_TE=farmer_community_invites_te
WHATSAPP_TEMPLATE_KN=farmer_community_invites_kn
WHATSAPP_TEMPLATE_HI=farmer_community_invites_hi
